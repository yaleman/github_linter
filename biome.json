{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "github_linter/**/*.js",
      "github_linter/**/*.css",
      "!!.venv/",
      "!!**/pico.min.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "lineWidth": 80,
      "expand": "always"
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 80,
      "expand": "always",
      "trailingNewline": false
    }
  },
  "overrides": [
    {
      "includes": [
        "*.vue"
      ],
      "linter": {
        "enabled": true
      },
      "formatter": {
        "enabled": true
      }
    }
  ]
}